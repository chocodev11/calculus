{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "version",
    "domainId",
    "archetypeId",
    "level",
    "recipe",
    "outcomeIds",
    "prerequisites",
    "misconceptions",
    "scene",
    "controls",
    "goals",
    "assessment",
    "accessibility",
    "config"
  ],
  "properties": {
    "prompt": { "type": "string" },
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "math.sandbox" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "domainId": { "enum": ["logic", "set", "trigonometry"] },
    "archetypeId": { "type": "string", "minLength": 1 },
    "level": { "enum": ["recognition", "understanding", "application", "advanced_application"] },
    "recipe": { "type": "string", "minLength": 1 },
    "outcomeIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "prerequisites": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "misconceptions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "scene": { "type": "object", "required": ["space"], "properties": { "space": { "type": "string" } }, "additionalProperties": true },
    "controls": { "type": "array", "items": { "$ref": "#/$defs/control" } },
    "goals": { "type": "array", "items": { "$ref": "#/$defs/goal" } },
    "solutionGraph": { "$ref": "#/$defs/solutionGraph" },
    "assessment": { "type": "array", "items": { "$ref": "#/$defs/assessment" } },
    "accessibility": {
      "type": "object",
      "required": ["keyboardControls", "textAlternative", "highContrast"],
      "properties": {
        "keyboardControls": { "const": true },
        "textAlternative": { "type": "string", "minLength": 1 },
        "highContrast": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "config": { "type": "object" },
    "feedback": { "type": "object" },
    "analytics": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "control": {
      "type": "object",
      "required": ["id", "type", "label"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["slider", "numeric_input", "choice", "toggle", "drag_item", "reset"] },
        "label": { "type": "string", "minLength": 1 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "initial": {},
        "options": { "type": "array" }
      },
      "additionalProperties": true
    },
    "goal": {
      "type": "object",
      "required": ["id", "evidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "evidence": {
          "anyOf": [
            { "enum": ["truth_value", "truth_table_complete", "unit_circle_value", "set_equal", "interval_equal", "triangle_valid", "triangle_solved", "measurement_consistent", "structured_steps"] },
            { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" }
          ]
        },
        "target": {},
        "required": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "assessment": {
      "type": "object",
      "required": ["id", "type", "prompt", "outcomeIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["choice", "boolean", "boolean_group", "set", "interval", "numeric", "fraction", "expression", "angle", "quantity", "ordered_steps", "structured_reasoning"] },
        "prompt": { "type": "string", "minLength": 1 },
        "outcomeIds": { "type": "array", "items": { "type": "string" } },
        "misconceptionIds": { "type": "array", "items": { "type": "string" } },
        "grading": { "type": "object" }
      },
      "additionalProperties": true
    },
    "solutionGraph": {
      "type": "object",
      "required": ["steps", "terminalStepIds"],
      "properties": {
        "steps": { "type": "array" },
        "terminalStepIds": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  }
}
