                "quiz_type": "multiple_choice",
                "question": "Tìm tất cả các giá trị thực của tham số $m$ để mệnh đề sau là **mệnh đề đúng**: \"$\\forall x \\in \\mathbb{R},\\; x^2 - 2mx + m + 6 > 0$\".",
                "options": [
                  {
                    "id": "A",
                    "text": "$-2 < m < 3$"
                  },
                  {
                    "id": "B",
                    "text": "$m < -2 \\text{ hoặc } m > 3$"
                  },
                  {
                    "id": "C",
                    "text": "$-3 < m < 2$"
                  },
                  {
                    "id": "D",
                    "text": "$m \\le -2 \\text{ hoặc } m \\ge 3$"
                  }
