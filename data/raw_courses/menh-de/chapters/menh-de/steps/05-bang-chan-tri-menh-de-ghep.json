{
  "id": "menh-de-bang-chan-tri",
  "title": "Mệnh đề ghép và bảng chân trị",
  "description": "Dùng bảng chân trị để xét phủ định, hội, tuyển, kéo theo và tương đương; không bỏ qua thứ tự ưu tiên của phép toán logic.",
  "xp_reward": 30,
  "order_index": 4,
  "slides": [
    {
      "order_index": 0,
      "blocks": [
        {
          "id": "compound-theory",
          "type": "text",
          "content": {
            "heading": "Mỗi dòng của bảng chân trị là một trường hợp",
            "paragraphs": [
              "Với hai mệnh đề p, q, bảng chân trị phải xét đủ bốn khả năng của (p, q). Mệnh đề p ∧ q chỉ đúng khi cả p và q đúng; p ∨ q đúng khi ít nhất một mệnh đề đúng.",
              "Mệnh đề kéo theo p ⇒ q tương đương với ¬p ∨ q, nên chỉ sai ở dòng p đúng, q sai. Hai mệnh đề tương đương khi có cùng giá trị ở mọi dòng; một vài trường hợp trùng nhau chưa đủ để kết luận tương đương."
            ]
          }
        },
        {
          "id": "precedence-warning",
          "type": "callout",
          "content": {
            "variant": "warning",
            "title": "Đặt ngoặc trước khi tính",
            "body": "Không đọc p ∨ q ∧ r như (p ∨ q) ∧ r. Hãy tách từng mệnh đề thành phần rồi đánh giá theo biểu thức đã đặt ngoặc."
          }
        }
      ]
    },
    {
      "order_index": 1,
      "blocks": [
        {
          "id": "truth-table-sandbox",
          "type": "interaction",
          "content": {
            "interactionType": "sandbox",
            "lesson": {
              "prompt": "Bật/tắt p và q để kiểm tra biểu thức p ∧ ¬q. Bảng bên dưới luôn hiển thị đủ bốn dòng để em so sánh kết quả.",
              "schemaVersion": "1.0",
              "kind": "math.sandbox",
              "id": "menh-de-truth-table-v1",
              "version": "1.0.0",
              "domainId": "logic",
              "archetypeId": "logic.compound_truth_table",
              "level": "understanding",
              "recipe": "logic.truth_table",
              "outcomeIds": ["M10-SET-02", "M10-SET-04"],
              "prerequisites": ["M10-SET-01"],
              "misconceptions": ["logic.and_or_precedence", "logic.incomplete_truth_table", "logic.negation_changes_only_symbol"],
              "scene": { "space": "truth_table" },
              "controls": [
                { "id": "p", "type": "toggle", "label": "p", "initial": false },
                { "id": "q", "type": "toggle", "label": "q", "initial": false }
              ],
              "goals": [{ "id": "current-row", "evidence": "truth_value", "target": true }],
              "solutionGraph": {
                "steps": [
                  { "id": "list-cases", "kind": "check", "hint": "Hai mệnh đề có 2² = 4 tổ hợp giá trị đúng/sai." },
                  { "id": "negate-q", "kind": "transform", "dependsOn": ["list-cases"], "hint": "Đổi q thành ¬q trước khi thực hiện phép hội." },
                  { "id": "read-result", "kind": "justify", "dependsOn": ["negate-q"], "hint": "p ∧ ¬q chỉ đúng khi p đúng và q sai." }
                ],
                "terminalStepIds": ["read-result"]
              },
              "assessment": [
                { "id": "truth-table-row", "type": "boolean", "prompt": "Với p đúng, q sai, giá trị của p ∧ ¬q là gì?", "outcomeIds": ["M10-SET-04"] },
                { "id": "truth-table-complete", "type": "ordered_steps", "prompt": "Giải thích vì sao phải xét đủ bốn dòng khi có hai mệnh đề thành phần.", "outcomeIds": ["M10-SET-04"] }
              ],
              "accessibility": {
                "keyboardControls": true,
                "textAlternative": "Bảng chân trị bốn dòng của biểu thức p và phủ định của q.",
                "highContrast": true
              },
              "config": {
                "mode": "truth_table",
                "variables": ["p", "q"],
                "expression": "p && !q",
                "initialValues": { "p": false, "q": false }
              },
              "analytics": ["predict", "truth_table_row_changed", "goal", "hint", "retry"]
            }
          }
        }
      ]
    },
    {
      "order_index": 2,
      "blocks": [
        {
          "id": "truth-table-check",
          "type": "quiz",
          "content": {
            "question": "Mệnh đề p ⇒ q sai trong trường hợp nào?",
            "options": [
              { "value": "a", "label": "p đúng, q đúng" },
              { "value": "b", "label": "p đúng, q sai" },
              { "value": "c", "label": "p sai, q đúng" },
              { "value": "d", "label": "p sai, q sai" }
            ],
            "correct": "b",
            "explanation": "Kéo theo chỉ sai khi giả thiết đúng nhưng kết luận sai."
          }
        }
      ]
    }
  ]
}
